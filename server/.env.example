# Copy this file to ".env" (same folder) and fill in your own values.
# .env is in .gitignore, so your secrets never go to GitHub.

PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas: Database > Connect > Drivers > copy the string, put your password in it
# and add the database name "advault" before the "?"
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/advault?retryWrites=true&w=majority

# Any long random text. It signs the login tokens.
JWT_SECRET=replace_me_with_a_long_random_string

# Stripe dashboard (Test mode) > Developers > API keys > Secret key
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Gmail: Google Account > Security > 2-Step Verification ON > App passwords > create one
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=abcdabcdabcdabcd

# Demo safety switch: if set, EVERY email goes to this inbox instead of the real recipient
# (the seeded accounts like creator@advault.com are not real inboxes). Leave empty to send normally.
EMAIL_OVERRIDE_TO=yourgmail@gmail.com
